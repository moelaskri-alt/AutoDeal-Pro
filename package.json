{
  "name": "autodeal-pro",
  "productName": "AutoDeal Pro",
  "version": "1.0.0",
  "description": "AutoDeal Pro - نظام إدارة معارض السيارات",
  "author": "AutoDeal Pro",
  "license": "UNLICENSED",
  "private": true,
  "main": "build/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "dev": "npm run build:main && npm run build:renderer && electron .",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "playwright-core": "1.56",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "homepage": "https://github.com/moelaskri-alt/autodeal-pro",
  "build": {
    "appId": "com.autodeal.pro",
    "productName": "AutoDeal Pro",
    "copyright": "Copyright © 2026 AutoDeal Pro",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "build/**/*",
      "!build/**/*.map",
      "build-resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "executableName": "AutoDealPro",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoDeal Pro",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "multiLanguageInstaller": true,
      "artifactName": "AutoDealPro-Setup-${version}.exe",
      "uninstallDisplayName": "AutoDeal Pro",
      "include": "build-resources/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build-resources/icon.png"
    }
  }
}
